{
  "expo": {
    "name": "Latea App",
    "slug": "latea-pos-mobile",
    "version": "9.7.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "latea-pos-mobile",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aplikasi memerlukan akses mikrofon untuk voice command.",
        "NSSpeechRecognitionUsageDescription": "Aplikasi memerlukan speech recognition untuk voice command."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.riyancode.lateaapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9E4BC"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk upload foto profil.",
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk mengambil foto profil."
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "86241233-bc46-47f3-8070-a5fb3302b59e" }
    },
    "owner": "riyan-code"
  }
}